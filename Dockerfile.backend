FROM node:22-alpine AS builder
RUN npm install -g pnpm
WORKDIR /build
COPY backend/package.json backend/pnpm-lock.yaml backend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY backend/ ./
RUN DATABASE_URL=postgresql://dummy:dummy@localhost:5432/dummy pnpm exec prisma generate
RUN pnpm run build

FROM node:22-alpine
RUN apk add --no-cache tini
WORKDIR /app
COPY --from=builder /build/dist ./dist
COPY --from=builder /build/node_modules ./node_modules
COPY --from=builder /build/package.json ./
COPY --from=builder /build/prisma/schema.prisma ./prisma/schema.prisma
COPY --from=builder /build/prisma/migrations ./prisma/migrations
COPY --from=builder /build/prisma.config.ts ./
COPY --from=builder /build/docker-entrypoint.sh ./
RUN sed -i 's/\r//' docker-entrypoint.sh && chmod +x docker-entrypoint.sh && mkdir -p /app/logs /backups
EXPOSE 3001
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["./docker-entrypoint.sh"]
