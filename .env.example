# ── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL password (used in DATABASE_URL)
DB_PASSWORD=change-me

# JWT signing secret — minimum 32 characters, keep secret
JWT_SECRET=change-me-minimum-32-characters-long-secret

# AES-256 encryption key for vault credentials — minimum 32 characters, keep secret
VAULT_ENCRYPTION_KEY=change-me-minimum-32-characters-long-key

# ── Optional ──────────────────────────────────────────────────────────────────

# Exposed port (default: 3000)
ORBIX_PORT=3000

# Timezone for cron schedules and timestamps (default: UTC)
TZ=Europe/Paris

# Minimum log level written to DB: DEBUG | INFO | WARN | ERROR (default: INFO)
LOG_LEVEL=INFO

# Set to true to enforce HTTPS-only cookies (enable in production behind TLS)
ORBIX_SECURE=false
